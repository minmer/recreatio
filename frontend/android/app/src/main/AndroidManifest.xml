<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Keine Sicherung: siehe xml/data_extraction_rules.xml. `fullBackupContent`
      gilt bis Android 11, die Regeln ab Android 12.
    -->
    <application
        android:name=".RecreatioApp"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme"
        tools:targetApi="31">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Links auf recreatio.pl öffnen in der App — ein persönlicher Link
              aus einer SMS, eine Seite der Pfarrei. Bestätigt wird das über
              /.well-known/assetlinks.json auf der Seite selbst; bis sie
              ausgeliefert ist, lässt es sich unter „Standardmäßig öffnen" von
              Hand einschalten.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="recreatio.pl" />
                <data android:host="www.recreatio.pl" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!--
          0075 — PUSH: Firebase weckt die App mit einem leeren Signal („sieh nach"),
          PushService fragt dann die Zahlen. Firebase holt seine Gerätekennung nicht
          von selbst beim Start, sondern erst, wenn Meldungen eingeschaltet werden
          (PushSetup.start); Statistik sammelt es keine.
        -->
        <service android:name=".PushService" android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data android:name="firebase_messaging_auto_init_enabled" android:value="false" />
        <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />

        <!--
          0076 — was der Mensch an einer Meldung tut (antworten, „Przeczytane",
          „Zrobione", wegwischen) und der Wecker für Aufgaben. Beide nur für die
          App selbst; den Neustart des Telefons meldet das System trotzdem.
        -->
        <receiver android:name=".ActionReceiver" android:exported="false" />
        <receiver android:name=".ReminderReceiver" android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!--
          0067 — Erinnerungen an Aufgaben liegen geplant im Wecker des Systems. Nach
          einem Neustart stellt der Empfänger des Plugins sie wieder hin; der
          Arbeiter im Hintergrund (WorkManager) bringt seinen eigenen mit.
        -->
    </application>

    <!--
      „Zrób zdjęcie" in der Rozmowa (`<input capture>`): die WebView-Hülle fragt
      mit resolveActivity, ob es eine Kamera-App gibt — ab Android 11 sieht sie
      ohne diese Zeilen keine und öffnet stattdessen nur die Dateiauswahl.
      Fotografiert wird dort in der Kamera-App; die Hülle fragt vorher nach
      CAMERA, weil die App sie (für den Scanner, unten) angibt.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sprachnachrichten im Gespräch (getUserMedia); gefragt wird erst beim ersten Aufnehmen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
      Der Scanner der Bibliothek (ISBN, eigene Nummer) liest das laufende Bild
      der Kamera (getUserMedia); gefragt wird erst beim ersten Scannen. Ohne
      Kamera läuft die App trotzdem — dann Foto oder Eintippen.
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!--
      Keine GENAUEN Wecker: Google Play erlaubt sie nur Wecker- und Kalender-Apps.
      Erinnerungen dürfen ein paar Minuten später kommen (setAndAllowWhileIdle).
      Nach einem Neustart werden sie wieder gestellt (RECEIVE_BOOT_COMPLETED, 0067).
    -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
</manifest>
