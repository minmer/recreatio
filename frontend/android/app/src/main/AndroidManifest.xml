<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Keine Sicherung: siehe xml/data_extraction_rules.xml. `fullBackupContent`
      gilt bis Android 11, die Regeln ab Android 12.
    -->
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="false"
        android:theme="@style/AppTheme"
        tools:targetApi="31">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|navigation|density"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Links auf recreatio.pl öffnen in der App — ein persönlicher Link
              aus einer SMS, eine Seite der Pfarrei. Bestätigt wird das über
              /.well-known/assetlinks.json auf der Seite selbst; bis sie
              ausgeliefert ist, lässt es sich unter „Standardmäßig öffnen" von
              Hand einschalten.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="recreatio.pl" />
                <data android:host="www.recreatio.pl" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>

        <!-- Benachrichtigungen werden nur sofort gezeigt, nie geplant: nach dem Neustart gibt es nichts nachzuholen. -->
        <receiver
            android:name="com.capacitorjs.plugins.localnotifications.LocalNotificationRestoreReceiver"
            tools:node="remove" />
    </application>

    <!--
      „Zrób zdjęcie" in der Rozmowa (`<input capture>`): die WebView-Hülle fragt
      mit resolveActivity, ob es eine Kamera-App gibt — ab Android 11 sieht sie
      ohne diese Zeilen keine und öffnet stattdessen nur die Dateiauswahl.
      Keine CAMERA-Berechtigung: fotografiert wird in der Kamera-App, nicht hier.
    -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
        <intent>
            <action android:name="android.media.action.VIDEO_CAPTURE" />
        </intent>
    </queries>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Sprachnachrichten im Gespräch (getUserMedia); gefragt wird erst beim ersten Aufnehmen. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!-- Was @capacitor/local-notifications mitbringt und diese App nicht braucht: sie plant nichts. -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" tools:node="remove" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" tools:node="remove" />
</manifest>
