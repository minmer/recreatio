        "ps1",
        "ps2",
        "piesn"
      ],
      "keys": {
        "enter": "next",
        "ctrlEnter": "more",
        "shiftEnter": "save"
      },
      "paste": {
        "columns": "|",
        "values": "/",
        "header": false
      }
    },
