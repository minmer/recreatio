{
  "format": "recreatio.cogita.schema",
  "version": 1,
  "name": "Psałterz (brewiarz)",
  "kinds": [
    {
      "ref": "@tekst",
      "name": "Psalm lub pieśń",
      "label": "{nazwa}",
      "tells": "poczatek",
      "fields": [
        {
          "key": "nazwa",
          "label": "Psalm lub pieśń (np. Ps 110, Flp 2,6-11)",
          "type": "line"
        },
        {
          "key": "miejsce",
          "label": "Miejsce w Piśmie",
          "type": "ref",
          "to": [
            "work"
          ],
          "locator": true,
          "says": "Pismo Święte z biblioteki, z której korzysta baza (dzieło rodzaju Biblia), i miejsce: Ps 110, Flp 2,6-11 — po nim szuka „Fragment Pisma”; tekstu Biblii nie przechowuje się"
        },
        {
          "key": "poczatek",
          "label": "Początek",
          "type": "line"
        },
        {
          "key": "rodzaj",
          "label": "Rodzaj",
          "type": "choice",
          "options": [
            {
              "value": "psalm",
              "label": "psalm"
            },
            {
              "value": "pieśń ST",
              "label": "pieśń ze Starego Testamentu"
            },
            {
              "value": "pieśń NT",
              "label": "pieśń z Nowego Testamentu"
            }
          ]
        }
      ]
    },
    {
      "ref": "@miejsce",
      "name": "Miejsce w brewiarzu",
      "label": "{tydzien} {dzien} · {godzina}",
      "fields": [
        {
          "key": "tydzien",
          "label": "Tydzień psałterza",
          "says": "Puste — co tydzień (np. kompleta)",
          "type": "choice",
          "options": [
            {
              "value": "I",
              "label": "Tydzień I"
            },
            {
              "value": "II",
              "label": "Tydzień II"
            },
            {
              "value": "III",
              "label": "Tydzień III"
            },
            {
              "value": "IV",
              "label": "Tydzień IV"
            }
          ]
        },
        {
          "key": "dzien",
          "label": "Dzień",
          "type": "choice",
          "options": [
            {
              "value": "niedziela",
              "label": "niedziela"
            },
            {
              "value": "poniedziałek",
              "label": "poniedziałek"
            },
            {
              "value": "wtorek",
              "label": "wtorek"
            },
            {
              "value": "środa",
              "label": "środa"
            },
            {
              "value": "czwartek",
              "label": "czwartek"
            },
            {
              "value": "piątek",
              "label": "piątek"
            },
            {
              "value": "sobota",
              "label": "sobota"
            }
          ]
        },
        {
          "key": "godzina",
          "label": "Godzina",
          "type": "choice",
          "options": [
            {
              "value": "I Nieszpory",
              "label": "I Nieszpory"
            },
            {
              "value": "II Nieszpory",
              "label": "II Nieszpory"
            },
            {
              "value": "Nieszpory",
              "label": "Nieszpory"
            },
            {
              "value": "Kompleta",
              "label": "Kompleta"
            },
            {
              "value": "Jutrznia",
              "label": "Jutrznia"
            },
            {
              "value": "Godzina czytań",
              "label": "Godzina czytań"
            },
            {
              "value": "Modlitwa w ciągu dnia",
              "label": "Modlitwa w ciągu dnia"
            }
          ]
        },
        {
          "key": "teksty",
          "label": "Psalmy i pieśni (po kolei)",
          "type": "ref",
          "multi": true,
          "to": [
            "@tekst"
          ]
        }
      ]
    }
  ],
  "forms": [
    {
      "ref": "@f-nieszpory",
