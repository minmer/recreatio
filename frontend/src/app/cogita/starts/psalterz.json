              "fields": {
                "nazwa": {
                  "from": "type"
                },
                "rodzaj": {
                  "from": "fixed",
                  "value": "pieśń NT"
                }
              }
            }
          },
          {
            "id": "miejsce",
            "type": "entry",
            "x": 260,
            "y": 170,
            "config": {
              "kind": "@miejsce",
              "label": "Dzień",
