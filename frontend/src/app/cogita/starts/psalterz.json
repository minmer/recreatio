              "reuse": "same",
              "fields": {
                "tydzien": {
                  "from": "ask",
                  "value": "I"
                },
                "dzien": {
                  "from": "type"
                },
                "godzina": {
                  "from": "ask",
                  "value": "Nieszpory"
                }
              }
            }
          }
        ],
        "edges": [
          {
            "id": "e1",
            "from": "ps1",
            "out": "out",
            "to": "miejsce",
            "in": "teksty"
          },
          {
            "id": "e2",
            "from": "ps2",
            "out": "out",
            "to": "miejsce",
            "in": "teksty"
          },
          {
            "id": "e3",
