{
  "name": "recreatio-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "api:types": "openapi-typescript ../backend/legacy/rc-openapi.json -o src/rc/lib/rcApiTypes.ts",
    "rc:test": "node scripts/rc-test.mjs",
    "rc:check": "tsc -p tsconfig.rc.json --noEmit && node scripts/rc-test.mjs && node scripts/rc-sql-params.mjs",
    "rc:sql": "node scripts/rc-sql-params.mjs",
    "app:check": "tsc -p tsconfig.app.json --noEmit && node scripts/app-urgency-check.mjs && node scripts/app-menu-check.mjs && node scripts/app-chat-check.mjs",
    "rc:walk": "node scripts/rc-walk.mjs",
    "rc:vector": "node scripts/rc-wrap-vector.mjs",
    "events:check": "node scripts/events-add-check.mjs && node scripts/events-image-check.mjs",
    "public:check": "tsc -p tsconfig.public.json --noEmit",
    "android:apk": "node scripts/android-apk.mjs",
    "android:keystore": "node scripts/android-keystore.mjs",
    "android:icons": "node scripts/android-icons.mjs",
    "android:release": "node scripts/android-apk.mjs --bundle",
    "android:publish": "node scripts/android-publish.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@dnd-kit/core": "^6.3.1",
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.96.2",
    "hash-wasm": "^4.12.0",
    "katex": "^0.16.28",
    "pyodide": "^0.29.3",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-katex": "^3.1.0",
    "react-router-dom": "^7.12.0",
    "reactflow": "^11.11.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.2",
    "@types/node": "^26.4.1",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
