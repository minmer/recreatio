# Build output and tool caches
/.vs
**/bin/
**/obj/
**/node_modules/
**/dist/
**/*.user
**/*.suo

# Built APKs and bundles (npm run android:apk)
android-out/

# The Thunderbird add-on (npm run thunderbird:xpi); the copy in public/ ships with the site build
thunderbird-out/
/frontend/public/thunderbird/

# Secrets never go into the tree:
#   development  dotnet user-secrets (outside the repository) and frontend/.env
#   production   appsettings.Production.json on the server
**/.env
**/.env.*
backend/*/appsettings.Production.json
backend/*/appsettings.*.local.json
/backend/Api/secrets/

# Local API diagnostic logs
/backend/Api/logs/
