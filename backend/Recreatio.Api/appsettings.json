{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost;Database=Recreatio;Trusted_Connection=True;TrustServerCertificate=True"
  },
  "Auth": {
    "RequireEmailConfirmation": false,
    "MaxFailedLoginAttempts": 5,
    "LockoutMinutes": 15,
    "SessionIdleMinutes": 60,
    "RememberMeDays": 30,
    "CookieDomain": "",
    "CookieSameSite": "None",
    "CookieSecurePolicy": "Always"
  },
  "Csrf": {
    "CookieDomain": "",
    "CookieSameSite": "None",
    "CookieSecurePolicy": "Always"
  },
  "_RcComment": "Die neue Plattform (Spezifikation 2.1). Dieselbe Datenbank wie der Altbestand, getrennt ueber das Praefix rc_ auf jeder Tabelle; eigenes Anmeldeverfahren. ConnectionString darf hier leer bleiben — dann gilt ConnectionStrings:DefaultConnection (siehe RcDb). Rc:ServerSecret gehoert NICHT hierher, sondern in dotnet user-secrets bzw. die Umgebung; erzeugen mit: dotnet run --project Rc.Schema -- secret",
  "Rc": {
    "ConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=Recreatio_Rc;Trusted_Connection=True;TrustServerCertificate=True",
    "ServerSecret": "",
    "FileStorePath": "rc-file-store",
    "CrossSiteCookies": true,
    "KeyVaultIdleMinutes": 15,
    "KeyVaultMaxEntries": 5000,
    "LoginMaxConcurrent": 4,
    "LoginMaxFailures": 10
  },
  "Crypto": {
    "ServerMasterSalt": "REPLACE_WITH_BASE64_SALT",
    "MasterKeyIterations": 600000,
    "MasterKeyLengthBytes": 32,
    "SharedViewIterations": 200000,
    "SharedViewKeyLengthBytes": 32
  },
  "DataProtection": {
    "CertificatePath": "",
    "CertificatePassword": "",
    "CertificateThumbprint": "",
    "RequireCertificateOutsideDevelopment": false
  },
  "BlobStorage": {
    "RootPath": "secure-file-store",
    "ChunkSizeBytes": 65536,
    "MaxUploadBytes": 52428800
  },
  "Calendar": {
    "ReminderPollSeconds": 60,
    "ReminderLookbackMinutes": 5,
    "ReminderLookaheadMinutes": 60,
    "ReminderBatchSize": 250,
    "WebhookSigningSecret": ""
  },
  "BookLookup": {
    "Enabled": true,
    "NationalLibraryPlEnabled": true,
    "NationalLibraryPlBaseUrl": "https://data.bn.org.pl",
    "_eIsbnComment": "e-isbn.pl has no API and must be scraped through a session cookie. Off by default; when on it is queried only if every other source misses.",
    "EIsbnPlEnabled": false,
    "EIsbnPlBaseUrl": "https://e-isbn.pl",
    "OpenLibraryEnabled": true,
    "_comment": "Open Library needs no key. Google Books is only consulted once GoogleBooksApiKey is set — keyless callers now get a per-day quota of zero.",
    "GoogleBooksEnabled": true,
    "OpenLibraryBaseUrl": "https://openlibrary.org",
    "GoogleBooksBaseUrl": "https://www.googleapis.com",
    "GoogleBooksApiKey": "",
    "UserAgent": "RecreatioLibrary/1.0 (+https://recreatio.pl)",
    "RequestTimeoutMs": 6000
  },
  "PythonSandbox": {
    "BaseUrl": "",
    "ApiKey": "",
    "Enabled": false,
    "BuiltInEnabled": true,
    "BuiltInPythonCommand": "python3",
    "AllowPublicStoryboard": false,
    "DefaultCaseCount": 5,
    "MaxCaseCount": 20,
    "RequestTimeoutMs": 10000
  }
}
