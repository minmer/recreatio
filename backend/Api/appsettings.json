// Nur, was jeder lesen darf. Die Verbindung steht in appsettings.Production.json
// (auf dem Server, nicht im Git) oder in dotnet user-secrets.
//
// Die Datei ersetzt bei jeder Veroeffentlichung die des Altbestands auf dem
// Server — ohne sie laese der Dienst dessen Einstellungen mit.
{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Api": {
    "Origins": "https://recreatio.pl"
  }
}
