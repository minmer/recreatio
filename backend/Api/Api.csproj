<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Der Dienst der Plattform — ein Ordner je Bereich (Identity, Roles, Areas,
    Pages, Forms, Calendar, …), alles im Namensraum `Api`.

    Er referenziert `Kernel` und nichts sonst. Der Kernel rechnet mit BYTES
    — Versiegelung, AAD, kanonische Form, Kennungen, Kettenzeilen — und weiss
    von Pfarreien, Gruppen und Ereignissen nichts. Deshalb waere es ein Fehler,
    ihn neu zu schreiben: geprueft ist er durch Kernel.Tests, und eine zweite,
    frisch getippte Kryptografie ist genau die Stelle, an der lautlose Fehler
    entstehen.
  -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Api</RootNamespace>

    <!--
      Die Benutzergeheimnisse der Entwicklung (Verbindungszeichenfolge); in der
      Produktion steht sie in appsettings.Production.json auf dem Server.
    -->
    <UserSecretsId>4daf5463-ef25-42a2-b3b0-c2eb770951d9</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.0.2" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="2.3.0" />

    <!--
      System.Security.Cryptography.Pkcs kommt ueber Microsoft.Data.SqlClient
      herein (9.0.13) — und 9.0.0 bis 9.0.20, 10.0.0 bis 10.0.12 sind
      verwundbar (CVE-2026-84008, CVE-2026-70162, beide Denial of Service;
      GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Die Pruefung von NuGet bricht
      den Bau dann ab (NU1902/NU1903, Warnungen sind Fehler). Bis SqlClient
      selbst eine behobene Fassung zieht (auch 7.1.1 nimmt noch 9.0.18),
      steht die behobene hier ausdruecklich — sie gewinnt gegen die
      mitgebrachte.
    -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kernel\Kernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      Die Skripte reisen IM Programm mit. Ein Migrationslauf, der seine Dateien
      erst im Dateisystem suchen muss, wendet auf dem Zielrechner etwas anderes
      an als auf dem Entwicklungsrechner.
    -->
    <EmbeddedResource Include="Sql\*.sql" />
  </ItemGroup>

</Project>
