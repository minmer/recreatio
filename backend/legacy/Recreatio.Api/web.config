<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <aspNetCore
      processPath="dotnet"
      arguments=".\Recreatio.Api.dll"
      stdoutLogEnabled="true"
      stdoutLogFile=".\logs\stdout"
      hostingModel="inprocess">
      <environmentVariables>
        <environmentVariable name="DataProtection__RequireCertificateOutsideDevelopment" value="false" />

        <!--
          DER SCHALTER FUER DEN EINMALIGEN UMZUG DER GALERIE.

          `Events:PhotoOffload` heisst als Umgebungsvariable
          `Events__PhotoOffload` — ZWEI Unterstriche. Das ist die Schreibweise,
          die .NET in einen Doppelpunkt zurueckuebersetzt; mit einem
          Unterstrich oder mit einem Doppelpunkt kommt die Einstellung schlicht
          nicht an, und der Lauf meldet weiter „disabled", ohne dass jemand
          sieht warum.

          KEIN GEHEIMNIS. Diese Datei liegt im Git — hier darf nur stehen, was
          jeder lesen darf. Ein Wahrheitswert darf es.

          Er steht auf `true`, WEIL die Datenbank am Anschlag ist. Wer diese
          Anwendung woanders hinstellt und dabei auf dieselbe Datenbank zeigt,
          muss ihn dort auf `false` setzen: der Umzug schreibt die Dateien auf
          die Platte DIESER Maschine und leert danach die Zeilen. Auf einem
          Entwicklungsrechner hiesse das, 61 MB fremder Fotos auf einen Laptop
          zu holen und vom Server verschwinden zu lassen.
        -->

        <!--
          WO DIE BILDER LANDEN.

          Ausdruecklich hingeschrieben statt der eingebauten Vorgabe, damit die
          Stelle SICHTBAR ist: 61 MB Fotos, deren Ablageort man erst im
          Quelltext nachschlagen muss, sind 61 MB, die beim naechsten
          Serverwechsel niemand mitnimmt.

          `..\data\event-photos` liegt NEBEN dem veroeffentlichten Ordner —
          ausserhalb dessen, was eine Veroeffentlichung ueberschreibt, und
          ausserhalb dessen, was der Webserver ausliefert. Beides ist Absicht.
          Ob der Anwendungspool dort schreiben darf, sagt
          `GET /events/admin/photo-storage` im Feld `store.writable`, samt
          aufgeloestem Pfad — nachsehen, BEVOR der erste Lauf etwas leert.
        -->
        <environmentVariable name="Events__PhotoStorePath" value="..\data\event-photos" />
      </environmentVariables>
    </aspNetCore>
  </system.webServer>
</configuration>
