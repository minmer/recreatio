{
  "format": "recreatio.cogita.schema",
  "version": 1,
  "name": "Księga z numerowanymi częściami — prefacje, modlitwy, pieśni, artykuły",
  "kinds": [
    {
      "ref": "@jednostki/jednostka",
      "name": "Część księgi",
      "label": "{oznaczenie}",
      "tells": "nr",
      "fields": [
        {
          "key": "nr",
          "label": "Numer",
          "type": "number",
          "says": "Kolejny numer części w księdze albo w jej grupie (1, 2, 3…) — według niego układają się widoki. Numer z księgi („P 12”, „I”) idzie do „Oznaczenia”."
        },
        {
          "key": "oznaczenie",
          "label": "Oznaczenie",
          "type": "line",
          "says": "Jak część nazywa księga: „Prefacja o Adwencie I”, „Prefacja o Najświętszej Eucharystii II”, „Kolekta z I niedzieli Adwentu”."
        },
        {
          "key": "rodzaj",
          "label": "Rodzaj części",
          "type": "choice",
          "options": [
            {
              "value": "prefacja",
              "label": "Prefacja"
            },
            {
              "value": "kolekta",
              "label": "Kolekta"
            },
            {
              "value": "nad-darami",
              "label": "Modlitwa nad darami"
            },
            {
              "value": "po-komunii",
              "label": "Modlitwa po Komunii"
            },
            {
              "value": "modlitwa-eucharystyczna",
              "label": "Modlitwa eucharystyczna"
            },
            {
              "value": "antyfona",
              "label": "Antyfona"
            },
            {
              "value": "hymn",
              "label": "Hymn"
            },
            {
              "value": "psalm",
              "label": "Psalm"
            },
            {
              "value": "artykul",
              "label": "Artykuł"
            },
            {
              "value": "inne",
              "label": "Inna część"
            }
          ],
          "says": "Jaka to część. Listę można rozszerzać — nowa możliwość to nowa pozycja, nie nowy schemat."
        },
        {
          "key": "incipit",
          "label": "Początek",
          "type": "text",
          "says": "Początek tej części — słowa, po których się ją rozpoznaje. Gdy wszystkie części zaczynają się tą samą formułą (prefacje: „Zaprawdę, godne to i sprawiedliwe…”), wpisz pierwsze słowa PO tej formule, dokładnie jak w księdze."
        },
        {
          "key": "tresc",
          "label": "O czym jest",
          "type": "blocks",
          "says": "Pierwsze zdanie: o czym jest ta część — jej myśl przewodnia, własnymi słowami (najwyżej 200 znaków). Dalej najważniejsze myśli, po kolei."
        },
        {
          "key": "motywy",
          "label": "Motywy",
          "type": "list",
          "says": "Słowa i obrazy, po których ją poznać (każdy w osobnej linii): „czuwanie”, „podwójne przyjście”."
        },
        {
          "key": "grupa",
          "label": "Grupa",
          "type": "ref",
          "to": [
            "@jednostki/grupa"
          ],
          "structure": "up",
          "prerequisite": "up",
          "inverse": "Części",
          "says": "Grupa albo dział księgi, w którym jest część (np. „Prefacje adwentowe”). Grupa jest ogólniejsza: najpierw poznaje się, czym się wyróżnia, potem jej części."
        },
        {
          "key": "miejsce",
          "label": "W księdze",
          "type": "ref",
          "to": [
            "work"
          ],
          "locator": true,
          "says": "Księga z biblioteki i miejsce części — strona tak, jak stoi w księdze: „s. 12*”, „s. 456”, „s. 3''” (znak serii stron, gdy księga ma kilka numeracji)."
        },
        {
          "key": "podobne",
          "label": "Podobne",
          "type": "ref",
          "to": [
            "@jednostki/jednostka"
          ],
          "multi": true,
          "symmetric": true,
          "says": "Części podobne do tej — te, które łatwo pomylić (tej samej grupy albo o tym samym temacie)."
        },
        {
          "key": "roznica",
          "label": "Czym się różni",
          "type": "text",
          "says": "Czym ta część różni się od podobnych: inna myśl, inny obraz, inne słowo kluczowe."
        },
        {
          "key": "uzycie",
          "label": "Kiedy się jej używa",
          "type": "text",
          "says": "Kiedy i do czego się jej używa (np. „od I niedzieli Adwentu do 16 grudnia”)."
        }
      ]
    },
    {
      "ref": "@jednostki/grupa",
      "name": "Grupa części",
      "label": "{nazwa}",
      "tells": "nr",
      "fields": [
        {
          "key": "nazwa",
          "label": "Nazwa",
          "type": "line",
          "says": "Nazwa grupy albo działu: „Prefacje adwentowe”, „Obrzędy wstępne”, „Okres zwykły”."
        },
        {
          "key": "nr",
          "label": "Kolejność",
          "type": "number",
          "says": "Numer grupy w kolejności księgi — według niego układają się grupy w widokach."
        },
        {
          "key": "opis",
          "label": "Czym się wyróżnia",
          "type": "markup",
          "says": "Co łączy części tej grupy i czym różni się ona od innych — dwa–trzy zdania, ogólnie."
        },
        {
          "key": "nalezy",
          "label": "Należy do",
          "type": "ref",
          "to": [
            "@jednostki/grupa"
          ],
          "structure": "up",
          "prerequisite": "up",
          "inverse": "Grupy w środku",
          "says": "Szerszy dział (np. „Prefacje” → „Prefacje adwentowe”)."
        },
        {
          "key": "miejsce",
          "label": "W księdze",
          "type": "ref",
          "to": [
            "work"
          ],
          "locator": true,
          "says": "Księga i zakres stron grupy, np. „s. 400–412”, „s. 1*–20*”."
        }
      ]
    }
  ],
