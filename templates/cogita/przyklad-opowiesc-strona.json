          "next": "gate:przeglad-wynik"
        },
        {
          "key": "przeglad-wynik",
          "label": "Trzy z trzech?",
          "type": "condition",
          "when": {
            "type": "value",
            "value": "opowiesc.przeglad",
            "op": "ge",
            "than": 3
