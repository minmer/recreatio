{
  "format": "recreatio/page",
  "version": 1,
  "title": "Skąd się bierze deszcz",
  "lead": "Opowieść, która liczy się w Cogicie: trzy drogi, jedno spotkanie, na końcu przegląd z trzech pytań — i mapa, która pokazuje, gdzie jesteś.",
  "mode": "presentation",
  "show": {
    "format": "screen",
    "nav": "dots",
    "story": {
      "base": "<id-bazy-wiedzy>",
      "gates": [
        {
          "key": "podstawy",
          "label": "Zna już wodę wokół nas?",
          "type": "condition",
          "when": {
            "type": "knowness",
            "of": "@opowiesc/t/start",
            "band": "known"
          },
          "yes": "rozwidlenie",
          "no": "podstawy"
        },
        {
          "key": "wszystko",
          "label": "Wszystkie trzy drogi za nim?",
          "type": "condition",
          "when": {
            "type": "and",
            "items": [
              {
                "type": "knowness",
                "of": "@opowiesc/t/parowanie",
                "band": "learned"
              },
              {
                "type": "knowness",
                "of": "@opowiesc/t/chmury",
                "band": "learned"
              },
              {
                "type": "knowness",
                "of": "@opowiesc/t/opady",
                "band": "learned"
              }
            ]
          },
          "yes": "razem",
          "no": "rozwidlenie"
        },
        {
          "key": "przeglad-zero",
          "label": "Przegląd od zera",
          "type": "set",
          "actions": [
            {
              "type": "set",
              "value": "opowiesc.przeglad",
              "to": 0
            }
          ],
          "next": "przeglad-1"
        },
        {
          "key": "przeglad-dobrze-1",
          "label": "Dobrze (1)",
          "type": "set",
          "actions": [
            {
              "type": "add",
              "value": "opowiesc.przeglad",
              "by": 1
            }
          ],
          "next": "przeglad-2"
        },
        {
          "key": "przeglad-dobrze-2",
          "label": "Dobrze (2)",
          "type": "set",
          "actions": [
            {
              "type": "add",
              "value": "opowiesc.przeglad",
              "by": 1
            }
          ],
          "next": "przeglad-3"
        },
        {
          "key": "przeglad-dobrze-3",
          "label": "Dobrze (3)",
          "type": "set",
          "actions": [
            {
              "type": "add",
              "value": "opowiesc.przeglad",
              "by": 1
            }
