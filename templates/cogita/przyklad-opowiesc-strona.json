            "type": "knowness",
            "of": "@opowiesc/t/start",
            "band": "known"
          },
          "yes": "rozwidlenie",
          "no": "podstawy"
        },
        {
          "key": "wszystko",
          "label": "Wszystkie trzy drogi za nim?",
          "type": "condition",
