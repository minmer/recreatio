{
  "format": "recreatio.cogita.schema",
  "version": 1,
  "name": "Pojęcia z kolejnością nauki — od podstaw do szczegółów",
  "kinds": [
    {
      "ref": "@podstawy/pojecie",
      "name": "Pojęcie",
      "label": "{nazwa}",
      "tells": "dziedzina",
      "fields": [
        {
          "key": "nazwa",
          "label": "Nazwa",
          "type": "line",
          "says": "Jak się nazywa pojęcie: „Atom”, „Orbital”, „Liczba atomowa”."
        },
        {
          "key": "czym",
          "label": "Czym jest",
          "type": "markup",
          "says": "Jedno–dwa zdania: czym jest to pojęcie — tak, żeby zrozumiał je ktoś, kto zna już to, czego ono wymaga."
        },
        {
          "key": "wymaga",
          "label": "Wymaga",
          "type": "ref",
          "to": [
            "@podstawy/pojecie"
          ],
          "multi": true,
          "prerequisite": "up",
          "inverse": "Na tym budują",
          "says": "Pojęcia, które trzeba znać WCZEŚNIEJ, żeby zrozumieć to (orbital wymaga powłoki elektronowej; elektron wymaga atomu). Tylko bezpośrednie — dalsze wynikają same. Puste: pojęcie podstawowe. Z tego pola aplikacja liczy poziomy od podstaw: karty pojęcia przychodzą, gdy umiesz to, czego ono wymaga."
        },
        {
          "key": "dziedzina",
          "label": "Dziedzina",
          "type": "line",
          "says": "Np. „Chemia”, „Fizyka” — odróżnia pojęcia o tej samej nazwie."
        },
        {
          "key": "przyklad",
          "label": "Przykład",
          "type": "text",
          "says": "Przykład albo ilustracja (nieobowiązkowo)."
        }
      ]
    }
  ],
