{
  "format": "recreatio.cogita.schema",
  "version": 1,
  "name": "Fakty w dziele — co jest prawdą, skąd to wiadomo i jak to opowiada dzieło",
  "kinds": [
    {
      "ref": "@fakty/fakt",
      "name": "Fakt",
      "label": "{tresc}",
      "tells": "kiedy",
      "fields": [
        {
          "key": "tresc",
          "label": "Treść",
          "type": "blocks",
          "says": "Pierwsze zdanie to sam fakt — krótko, własnymi słowami, jak twierdzenie o rzeczywistości (najwyżej 200 znaków): „Karol Wojtyła przyjął święcenia kapłańskie 1 listopada 1946 roku.”. Dalej szczegóły. Fakt jest jeden: dwa twierdzenia to dwa fakty."
        },
        {
          "key": "kogo",
          "label": "Kogo i czego dotyczy",
          "type": "ref",
          "multi": true,
          "inverse": "Fakty",
          "says": "Osoby, miejsca, rzeczy, których fakt dotyczy — wpisy tej bazy (np. Element stały: postać, miejsce) albo osoby z biblioteki."
        },
        {
          "key": "kiedy",
          "label": "Kiedy",
          "type": "date",
          "uncertain": true,
          "says": "Data z dokładnością, jaką znamy: rok, miesiąc albo dzień; niepewna — ze stanem (przybliżona, sporna…), źródłem i notatką."
        },
        {
          "key": "gdzie",
          "label": "Gdzie",
          "type": "ref",
          "multi": true,
          "says": "Miejsce zdarzenia — wpis tej bazy (np. Element stały: miejsce)."
        },
        {
          "key": "okres",
          "label": "Okres",
          "type": "ref",
          "to": [
            "@fakty/okres"
          ],
          "multi": true,
          "structure": "up",
          "prerequisite": "up",
          "inverse": "Fakty z tego okresu",
          "says": "Okres albo etap życia, do którego fakt należy (np. „Dzieciństwo w Wadowicach”). Okres jest ogólniejszy — jego karty przychodzą przed kartami faktów."
        },
        {
          "key": "wDziele",
          "label": "W dziele",
          "type": "ref",
          "to": [
            "work"
          ],
          "multi": true,
          "locator": true,
          "says": "Gdzie to mówi omawiane dzieło (powieść, film, wspomnienia): dzieło z biblioteki i miejsce, np. „s. 45–47”. Dzieło jest ŹRÓDŁEM tej informacji — nawet gdy ją upiększa."
        },
        {
          "key": "jakWDziele",
          "label": "Jak przedstawia to dzieło",
          "type": "text",
          "says": "Jak dzieło to opowiada: wiernie, w skrócie, z wymyślonym dialogiem, z inną datą, z postacią złożoną z kilku osób… Bez oceny — opis."
        },
        {
          "key": "historycznosc",
          "label": "Zgodność z historią",
          "type": "choice",
          "options": [
            {
              "value": "potwierdzone",
              "label": "potwierdzone w innych źródłach"
            },
            {
              "value": "prawdopodobne",
              "label": "prawdopodobne"
            },
            {
              "value": "sporne",
              "label": "sporne — źródła się różnią"
            },
            {
              "value": "uproszczone",
              "label": "prawdziwe, ale uproszczone albo udramatyzowane"
            },
            {
              "value": "fikcja",
              "label": "wymyślone przez autora"
            },
            {
              "value": "nieznane",
              "label": "nie wiadomo — brak innych źródeł"
            }
          ],
          "says": "Ocena po sprawdzeniu innych źródeł: potwierdzone (inne źródła mówią to samo), prawdopodobne, sporne (źródła się różnią), uproszczone (prawda, ale uproszczona albo udramatyzowana), fikcja (wymyślone przez autora), nieznane (nie znaleziono innego źródła). Bez sprawdzenia — puste."
        },
        {
          "key": "zrodla",
          "label": "Inne źródła",
          "type": "ref",
          "to": [
            "work"
          ],
          "multi": true,
          "locator": true,
          "says": "Źródła z biblioteki, które potwierdzają albo przeczą (biografie, dokumenty, encyklopedie) — z miejscem."
        },
        {
          "key": "zrodlaPoza",
          "label": "Źródła spoza biblioteki",
          "type": "list",
          "says": "Źródła, których nie ma w bibliotece: „Encyklopedia PWN, hasło …”, adres strony, archiwum — każde w osobnej linii. Lepiej dodać źródło do biblioteki i wskazać je w „Inne źródła”."
        },
        {
          "key": "ocena",
          "label": "Uzasadnienie oceny",
          "type": "text",
          "says": "Dlaczego taka ocena: co mówią inne źródła, czym się różnią od dzieła, czego nie da się sprawdzić."
        },
        {
          "key": "wymaga",
          "label": "Najpierw trzeba znać",
          "type": "ref",
          "multi": true,
          "prerequisite": "up",
          "inverse": "Na tym budują",
          "says": "Fakty albo wpisy, które trzeba znać wcześniej, żeby ten zrozumieć (wybór na papieża wymaga faktu, że był kardynałem). Tylko bezpośrednie."
        }
      ]
    },
    {
      "ref": "@fakty/okres",
      "name": "Okres",
      "label": "{nazwa}",
      "tells": "od",
      "fields": [
        {
          "key": "nazwa",
          "label": "Nazwa",
          "type": "line",
          "says": "Okres albo etap: „Dzieciństwo w Wadowicach”, „Okupacja”, „Pontyfikat”."
        },
        {
          "key": "od",
          "label": "Od",
          "type": "date",
          "uncertain": true,
          "says": "Początek okresu (rok, miesiąc albo dzień)."
        },
        {
          "key": "do",
          "label": "Do",
          "type": "date",
          "uncertain": true,
          "says": "Koniec okresu."
        },
        {
          "key": "nr",
          "label": "Kolejność",
          "type": "number",
          "says": "Numer okresu w kolejności (1 — najwcześniejszy) — według niego układają się okresy w widokach."
        },
        {
          "key": "opis",
          "label": "Opis",
          "type": "markup",
          "says": "Najważniejsze o tym okresie w dwóch–trzech zdaniach — to, co trzeba wiedzieć, zanim przyjdą szczegóły."
        },
        {
          "key": "nalezy",
          "label": "Należy do",
          "type": "ref",
          "to": [
            "@fakty/okres"
          ],
          "structure": "up",
          "prerequisite": "up",
          "inverse": "Okresy w środku",
          "says": "Szerszy okres, w którym ten leży (np. „Młodość” w „Życie przed kapłaństwem”)."
        }
      ]
    }
  ],
