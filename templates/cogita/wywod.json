  "forms": [
    {
      "ref": "@wywod/f-pytania",
      "name": "Pytania dzieła — wiersz po wierszu",
      "says": "Na początek dzieło. W każdym wierszu pytanie i jego miejsce (np. „Czy Bóg istnieje? | I q. 2 a. 3”) — powstaje pytanie wiodące, pod które potem dopisuje się kroki.",
      "graph": {
        "nodes": [
          { "id": "dzielo", "type": "pick", "x": 0, "y": 0, "config": { "label": "Dzieło", "kinds": ["work"], "many": false, "optional": false, "value": [] } },
          { "id": "pyt", "type": "entry", "x": 320, "y": 0, "config": { "kind": "@wywod/krok", "label": "Pytanie", "many": false, "reuse": "same", "fields": { "rola": { "from": "fixed", "value": "pytanie" }, "tresc": { "from": "type" }, "miejsce": { "from": "type" } } } }
        ],
