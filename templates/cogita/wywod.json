      "paste": { "columns": "|", "values": ";", "header": false }
    },
    {
      "ref": "@wywod/f-kroki",
      "name": "Kroki pod krokiem — wiersz po wierszu",
      "says": "Na początek dzieło i krok, pod którym dopisujesz (np. pytanie wiodące albo rozdział). W każdym wierszu: rola, treść (pierwsze zdanie to teza), pełne miejsce w dziele („I q. 2 a. 3 arg. 1”, „s. 47”), ważny fragment (dosłownie) i — gdy kilka kroków ma to samo miejsce — numer.",
      "graph": {
        "nodes": [
          { "id": "dzielo", "type": "pick", "x": 0, "y": 0, "config": { "label": "Dzieło", "kinds": ["work"], "many": false, "optional": false, "value": [] } },
          { "id": "nad", "type": "pick", "x": 0, "y": 160, "config": { "label": "Pod krokiem", "kinds": ["@wywod/krok"], "many": false, "optional": false, "value": [] } },
          { "id": "krok", "type": "entry", "x": 320, "y": 80, "config": { "kind": "@wywod/krok", "label": "Krok wywodu", "many": false, "reuse": "same", "fields": { "rola": { "from": "type" }, "tresc": { "from": "type" }, "miejsce": { "from": "type" }, "fragment": { "from": "type" }, "nr": { "from": "type" } } } }
        ],
        "edges": [
          { "id": "e1", "from": "dzielo", "out": "out", "to": "krok", "in": "miejsce" },
          { "id": "e2", "from": "nad", "out": "out", "to": "krok", "in": "nalezy" }
        ]
      },
      "keys": { "enter": "next", "ctrlEnter": "more", "shiftEnter": "save" },
      "paste": { "columns": "|", "values": ";", "header": false }
    },
    {
      "ref": "@wywod/f-elementy",
      "name": "Elementy stałe dzieła — wiersz po wierszu",
      "says": "Na początek dzieło. W każdym wierszu: czym jest element (pojęcie, postać, miejsce…), jego nazwa w dziele, opis (pierwsze zdanie — jak dzieło go rozumie) i miejsce, gdzie dzieło go wprowadza.",
      "graph": {
        "nodes": [
          { "id": "dzielo", "type": "pick", "x": 0, "y": 0, "config": { "label": "Dzieło", "kinds": ["work"], "many": false, "optional": false, "value": [] } },
          { "id": "el", "type": "entry", "x": 320, "y": 0, "config": { "kind": "@wywod/element", "label": "Element stały", "many": false, "reuse": "same", "fields": { "czym": { "from": "type" }, "nazwa": { "from": "type" }, "opis": { "from": "type" }, "miejsce": { "from": "type" } } } }
        ],
        "edges": [{ "id": "e1", "from": "dzielo", "out": "out", "to": "el", "in": "miejsce" }]
      },
      "keys": { "enter": "next", "ctrlEnter": "more", "shiftEnter": "save" },
      "paste": { "columns": "|", "values": ";", "header": false }
    }
  ],
