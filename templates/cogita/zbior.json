{
  "format": "recreatio.cogita.schema",
  "version": 1,
  "name": "Zbiór — pozycje do rozpoznania i rozróżnienia (modlitwy, prefacje, pieśni, psalmy, artykuły, utwory, obrazy…)",
  "kinds": [
    {
      "ref": "@zbior/pozycja",
      "name": "Pozycja",
      "label": "{oznaczenie}",
      "tells": "nr",
      "fields": [
        {
          "key": "nr",
          "label": "Numer",
          "type": "number",
          "says": "Kolejność w zbiorze albo w grupie (1, 2, 3…) — według niej układają się widoki. Oznaczenie, pod którym pozycja stoi w źródle („P 12”, „Ps 23”, „KV 618”, „art. 12”), idzie do „Oznaczenia”."
        },
        {
          "key": "oznaczenie",
          "label": "Oznaczenie",
          "type": "line",
          "says": "Jak pozycję nazywa zbiór — tytuł, numer, sygnatura: „Prefacja o Adwencie I”, „Pieśń 112: Czarna Madonna”, „Psalm 23”, „Art. 12 Konstytucji”, „Sonata c-moll op. 13 (Patetyczna)”."
        },
        {
          "key": "poczatek",
          "label": "Początek",
          "type": "text",
          "says": "Pierwsze słowa (wers, fraza, zdanie), po których się ją rozpoznaje — dokładnie jak w źródle. Gdy wszystkie pozycje zaczynają się tą samą formułą (prefacje: „Zaprawdę, godne to i sprawiedliwe…”), wpisz słowa PO niej."
        },
        {
          "key": "tresc",
          "label": "O czym jest",
          "type": "blocks",
          "says": "Pierwsze zdanie: o czym jest — myśl przewodnia, własnymi słowami (najwyżej 200 znaków). Dalej najważniejsze myśli, po kolei."
        },
        {
          "key": "znaki",
          "label": "Znaki rozpoznawcze",
          "type": "list",
          "says": "Słowa, obrazy, motywy, cechy, po których ją poznać — każdy w osobnej linii („czuwanie”, „podwójne przyjście”; „tonacja d-moll”; „czerwony płaszcz”)."
        },
        {
          "key": "obraz",
          "label": "Obraz albo dźwięk",
          "type": "media",
          "media": [
            "image",
            "audio"
          ],
          "says": "Gdy rozpoznaje się ją także po obrazie albo dźwięku — zdjęcie, ilustracja, fragment melodii. Plik dodaje się w aplikacji."
        },
        {
          "key": "grupa",
          "label": "Grupa",
          "type": "ref",
          "to": [
            "@zbior/grupa"
          ],
          "structure": "up",
          "prerequisite": "up",
          "inverse": "Pozycje",
          "says": "Grupa, dział albo rodzaj, do którego należy („Prefacje adwentowe”, „Pieśni maryjne”, „Rozdział II. Wolności i prawa”). Grupa jest ogólniejsza: najpierw poznaje się grupę, potem jej pozycje."
        },
        {
          "key": "miejsce",
          "label": "Gdzie jest",
          "type": "ref",
          "to": [
            "work"
          ],
          "multi": true,
          "locator": true,
          "says": "Dzieło z biblioteki i miejsce w nim — strona, numer, werset, minuta nagrania; ta sama pozycja może stać w kilku dziełach (pieśń w dwóch śpiewnikach). Jak czytać to miejsce, wie Biblioteka (układ miejsc dzieła, także strony w osobno liczonych częściach książki)."
        },
        {
          "key": "podobne",
          "label": "Łatwo pomylić z",
          "type": "ref",
          "to": [
            "@zbior/pozycja"
          ],
          "multi": true,
          "symmetric": true,
          "says": "Pozycje podobne do tej — te, które łatwo pomylić (z tej samej grupy, o tym samym temacie, o podobnym początku)."
        },
        {
          "key": "roznica",
          "label": "Czym się różni",
          "type": "text",
          "says": "Czym różni się od tych, z którymi łatwo ją pomylić: inna myśl, inny obraz, inne słowo kluczowe."
        },
        {
          "key": "uzycie",
          "label": "Kiedy i do czego",
          "type": "text",
          "says": "Kiedy, przy jakiej okazji i do czego się jej używa („w Adwencie do 16 grudnia”, „na pogrzebach”, „gdy umowa jest nieważna”)."
        },
        {
          "key": "wymaga",
          "label": "Najpierw trzeba znać",
          "type": "ref",
          "multi": true,
          "prerequisite": "up",
          "inverse": "Na tym budują",
          "says": "Co trzeba znać wcześniej — pojęcie, inną pozycję. Tylko bezpośrednie."
        }
      ]
    },
    {
      "ref": "@zbior/grupa",
      "name": "Grupa",
      "label": "{nazwa}",
      "tells": "nr",
      "fields": [
        {
          "key": "nazwa",
          "label": "Nazwa",
          "type": "line",
          "says": "Nazwa grupy, działu albo rodzaju: „Prefacje”, „Prefacje adwentowe”, „Pieśni wielkanocne”, „Rozdział II Konstytucji”."
        },
        {
          "key": "nr",
          "label": "Kolejność",
          "type": "number",
          "says": "Numer grupy w kolejności zbioru — według niego układają się grupy w widokach."
        },
        {
          "key": "opis",
          "label": "Czym się wyróżnia",
          "type": "markup",
          "says": "Co łączy pozycje tej grupy i czym różni się ona od innych — dwa–trzy zdania, ogólnie."
        },
        {
          "key": "nalezy",
          "label": "Należy do",
          "type": "ref",
          "to": [
            "@zbior/grupa"
          ],
          "structure": "up",
          "prerequisite": "up",
          "inverse": "Grupy w środku",
          "says": "Szerszy dział („Prefacje” → „Prefacje adwentowe”)."
        },
        {
          "key": "miejsce",
          "label": "Gdzie jest",
          "type": "ref",
          "to": [
            "work"
          ],
          "multi": true,
          "locator": true,
          "says": "Dzieło z biblioteki i zakres grupy w nim („s. 400–412”, „nr 1–20”)."
        }
      ]
    }
  ],
